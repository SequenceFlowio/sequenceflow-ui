# Public application URLs (production must use HTTPS for Shopify webhooks)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI
OPENAI_API_KEY=
# Optioneel: model voor Vera's chat op /inventory (standaard gpt-4.1-mini).
# INVENTORY_ASSISTANT_MODEL=

# Resend / inbound email
RESEND_API_KEY=
RESEND_DEFAULT_FROM=SequenceFlow <noreply@mail.example.com>
RESEND_WEBHOOK_SECRET=
INBOUND_EMAIL_DOMAIN=inbox.example.com

# Mail credential encryption (use a long, random secret)
SMTP_CREDENTIAL_ENCRYPTION_KEY=
COMMERCE_CREDENTIAL_ENCRYPTION_KEY=
COMMERCE_IDENTITY_HMAC_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_AGENCY=

# Internal and cron routes
INTERNAL_API_SECRET=
CRON_SECRET=

# Beheerdashboard op sequenceflow.io/backoffice (alleen voor SequenceFlow zelf).
# Inloggen: eenmalige code per mail + authenticator-app. Leeg = niemand komt binnen.
PLATFORM_ADMIN_EMAILS=
# Lokaal bekijken met voorbeeldcijfers, zonder database of inlog (werkt nooit in productie):
# BACKOFFICE_DEMO=1

# Google Tag Manager staat standaard aan (GTM-T624SDZZ, lib/marketing/tags.ts) en laadt
# pas na toestemming van de bezoeker. Andere container: zet het id hier; uit: off.
# NEXT_PUBLIC_GTM_ID=
# GA4 zonder Tag Manager (optioneel):
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# Cijfers van GA4 in het beheerdashboard:
# GA4_PROPERTY_ID=
# GA4_SERVICE_ACCOUNT_JSON=

# Meta-pixel en advertentiecijfers (optioneel).
# NEXT_PUBLIC_META_PIXEL_ID=
# META_ADS_ACCESS_TOKEN=
# META_AD_ACCOUNT_ID=
